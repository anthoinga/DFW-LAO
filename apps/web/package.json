{
	"name": "web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --infer-origin-from-routes=false",
		"prepare": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && vitest --run",
		"test:e2e": "playwright test",
		"db:migrate": "wrangler d1 migrations apply dfw-lao-submissions --local",
		"i18n:ui": "node --experimental-strip-types scripts/i18n-ui.ts",
		"i18n:backfill": "node --experimental-strip-types scripts/i18n-backfill.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.8.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@sanity/client": "^8.16.0",
		"@sanity/image-url": "^2.1.1",
		"@sanity/visual-editing": "^6.2.1",
		"groq": "^6.23.0",
		"gsap": "^3.15.1",
		"lenis": "^1.3.27",
		"schema-dts": "^2.1.0",
		"uqr": "^0.1.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@inlang/plugin-message-format": "^4.6.0",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	}
}
